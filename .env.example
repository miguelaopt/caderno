# Modo browser de desenvolvimento: raiz do Moodle, SEM barra final e SEM /login nem /webservice.
# Na app Windows o endereço é indicado em Cadeiras.
# Ex.: https://moodle.exemplo.pt
MOODLE_URL=

# Em producao, obrigatoria: 32 bytes aleatorios em hexadecimal. Em desenvolvimento,
# a app cria data/product.key com permissoes 0600.
TOKEN_ENCRYPTION_KEY=
PRODUCT_DB_PATH=data/product.db
PRODUCT_FILES_DIR=data/product-files

# Shortname do servico de Web Services. O da app movel e o mais comum.
MOODLE_SERVICE=moodle_mobile_app

# Cadeira a inspecionar na Fase 1. Vazio = a primeira da lista.
MOODLE_COURSE_ID=

# Intervalo minimo entre pedidos ao Moodle, em ms. Nao baixar sem motivo.
MOODLE_REQUEST_GAP_MS=500

# Onde escrever os JSON de inspecao.
MOODLE_OUT_DIR=out

# Endpoints adicionais compatíveis com Chat Completions no modo browser de desenvolvimento.
# Lista de URLs base exatas, separadas por vírgula. Na app Windows a URL é indicada nas Definições.
AI_ALLOWED_BASE_URLS=

# Sistema pessoal antigo (scripts/analyze.mjs). A aplicação usa a chave de cada pessoa.
ANTHROPIC_API_KEY=

# Modelo. claude-opus-5 é o mais capaz e ~2,5x mais caro; para resumir
# slides, o sonnet-5 chega. claude-haiku-4-5 é ainda ~2x mais barato.
LLM_MODEL=claude-sonnet-5

# Esforço de raciocínio: low | medium | high | xhigh | max.
# "low" chega para resumir e é onde está a maior parte da poupança de saída.
# Ignorado em claude-haiku-4-5, que não aceita este parâmetro.
LLM_EFFORT=low
