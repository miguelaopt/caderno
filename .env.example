# Raiz do Moodle configurado, SEM barra final e SEM /login nem /webservice.
# Ex.: https://moodle.exemplo.pt
MOODLE_URL=

# Em producao, obrigatoria: 32 bytes aleatorios em hexadecimal. Em desenvolvimento,
# a app cria data/product.key com permissoes 0600.
TOKEN_ENCRYPTION_KEY=
PRODUCT_DB_PATH=data/product.db
PRODUCT_FILES_DIR=data/product-files

# Shortname do servico de Web Services. O da app movel e o mais comum.
MOODLE_SERVICE=moodle_mobile_app

# Cadeira a inspecionar na Fase 1. Vazio = a primeira da lista.
MOODLE_COURSE_ID=

# Intervalo minimo entre pedidos ao Moodle, em ms. Nao baixar sem motivo.
MOODLE_REQUEST_GAP_MS=500

# Onde escrever os JSON de inspecao.
MOODLE_OUT_DIR=out

# Opcional: chave Anthropic do operador para instalações antigas.
# Numa instalação open source, cada pessoa configura a sua chave nas Definições.
ANTHROPIC_API_KEY=

# Endpoints adicionais compatíveis com Chat Completions. Lista de URLs base
# exatas, separadas por vírgula. Nunca aceitar URLs arbitrárias de utilizadores.
AI_ALLOWED_BASE_URLS=

# Só ativa os planos e o Stripe no modo de serviço hospedado. Por defeito,
# não há pagamento nem limite de cadeiras na instalação open source.
ENABLE_HOSTED_BILLING=false

# IA do produto (resumos e perguntas). Os valores por milhao de tokens servem
# para estimar custos na area de administracao; ajustar segundo o contrato real.
LLM_SUMMARY_MODEL=claude-haiku-4-5
LLM_EXPLAIN_MODEL=claude-sonnet-5
LLM_SUMMARY_INPUT_USD_PER_M=1
LLM_SUMMARY_OUTPUT_USD_PER_M=5
LLM_EXPLAIN_INPUT_USD_PER_M=2
LLM_EXPLAIN_OUTPUT_USD_PER_M=10
ADMIN_USER_ID=

# Email diario, opcional. Configurar todos os campos para ativar.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Apenas com ENABLE_HOSTED_BILLING=true: criar Price recorrente no Stripe.
# Configurar webhook /api/stripe/webhook no dominio HTTPS publico.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# Modelo. claude-opus-5 é o mais capaz e ~2,5x mais caro; para resumir
# slides, o sonnet-5 chega. claude-haiku-4-5 é ainda ~2x mais barato.
LLM_MODEL=claude-sonnet-5

# Esforço de raciocínio: low | medium | high | xhigh | max.
# "low" chega para resumir e é onde está a maior parte da poupança de saída.
# Ignorado em claude-haiku-4-5, que não aceita este parâmetro.
LLM_EFFORT=low
